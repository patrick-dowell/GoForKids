++ (NSString * _Nonnull)runGtpWithHumanModel:(BOOL)useHumanModel {
+    NSBundle* mainBundle = [NSBundle mainBundle];
+    NSString* modelPath = [mainBundle pathForResource:@"default_model" ofType:@"bin.gz"];
+    NSString* configPath = [mainBundle pathForResource:@"default_gtp" ofType:@"cfg"];
+    NSString* humanModelPath = [mainBundle pathForResource:humanModelStubName ofType:@"bin.gz"];
+    BOOL withHuman = useHumanModel && [KataGoHelper humanModelInBundle];
+
+    // Replace the global cout and cin objects with the custom ones
+    cout.rdbuf(&tsbFromKataGo);
+    cin.rdbuf(&tsbToKataGo);
+
+    vector<string> subArgs;
+    subArgs.push_back(string("gtp"));
+    subArgs.push_back(string("-model"));
+    subArgs.push_back(string([modelPath UTF8String]));
+    if(withHuman) {
+        // The CoreML backend finds the human package in the bundle by name.
+        subArgs.push_back(string("-human-model"));
+        subArgs.push_back(string([humanModelPath UTF8String]));
+    }
+    subArgs.push_back(string("-config"));
+    subArgs.push_back(string([configPath UTF8String]));
+
+    string reason;
+    try {
+        int code = MainCmds::gtp(subArgs);
+        reason = "exited with code " + to_string(code);
+    } catch(const std::exception& e) {
+        reason = string("failed: ") + e.what();
+    } catch(...) {
+        reason = "failed with an unknown exception";
+    }
+    for(char& c : reason) {
+        if(c == '\n' || c == '\r')
+            c = ' ';
+    }
+
+    tsbToKataGo.clear();
+    cout << "? engine stopped: " << reason << endl << endl;
+    return [NSString stringWithUTF8String:reason.c_str()];
+}
