+			shellScript = "# Ship the raw .mlpackage files: Xcode would compile a package in Copy\n# Bundle Resources to .mlmodelc and drop the original, which the CoreML\n# loader needs. Needs User Script Sandboxing off.\nRES=\"${SRCROOT}/Resources\"\nOUT=\"${TARGET_BUILD_DIR}/${UNLOCALIZED_RESOURCES_FOLDER_PATH}\"\necho \"=== Copy raw mlpackage phase ===\"\ncopy_package() {\n  echo \"  src: ${RES}/$1\"\n  echo \"  dst: ${OUT}/$1\"\n  rm -rf \"${OUT}/$1\"\n  mkdir -p \"${OUT}\"\n  cp -R \"${RES}/$1\" \"${OUT}/$1\"\n}\nif [ ! -d \"${RES}/KataGoModel19x19fp16.mlpackage\" ]; then\n  echo \"ERROR: source mlpackage missing at ${RES}/KataGoModel19x19fp16.mlpackage\"\n  exit 1\nfi\ncopy_package KataGoModel19x19fp16.mlpackage\n# The human SL net, optional: the package and its .bin.gz stub, or neither.\n# Without them the app starts the engine without the human net.\nif [ -d \"${RES}/KataGoModel19x19fp16m1.mlpackage\" ] && [ -f \"${RES}/b18c384nbt-humanv0-null.bin.gz\" ]; then\n  copy_package KataGoModel19x19fp16m1.mlpackage\n  cp \"${RES}/b18c384nbt-humanv0-null.bin.gz\" \"${OUT}/\"\n  echo \"  human SL net copied\"\nelse\n  rm -rf \"${OUT}/KataGoModel19x19fp16m1.mlpackage\" \"${OUT}/b18c384nbt-humanv0-null.bin.gz\"\n  echo \"  human SL net not in Resources: building without it\"\nfi\necho \"Copy complete.\"\n";
